# ============================================================
#  wirego — minimal required configuration
#
#  Copy to .env and fill in the two secrets below. Everything
#  else — including firewall backend, log level, public IP/domain,
#  DNS, TLS, and more — is configured from the web panel after
#  first login (System → Settings). Full guide: docs/deploy-docker.md
# ============================================================

# ════════════════════════════════════════════════════════════
#  SECRETS — REQUIRED (the process refuses to start without them)
#  These values can NEVER be changed after the first start —
#  changing them makes existing peer keys unreadable and
#  invalidates all sessions.
# ════════════════════════════════════════════════════════════

# AES-256 key for encrypting peer private keys at rest in SQLite.
# Generate: head -c 32 /dev/urandom | base64 | tr -d '\n'
WIREGO_DB_ENCRYPTION_KEY=

# Ed25519 seed for signing JWT tokens (access + refresh). 32 bytes
# minimum; 64 (the command below) works too.
# Generate: head -c 64 /dev/urandom | base64 | tr -d '\n'
WIREGO_JWT_SIGNING_KEY=

# Using Docker secrets instead of plain env vars? Point these at the
# mounted secret files instead — same requirements as above apply.
# WIREGO_DB_ENCRYPTION_KEY_FILE=/run/secrets/wirego_db_key
# WIREGO_JWT_SIGNING_KEY_FILE=/run/secrets/wirego_jwt_key


# ════════════════════════════════════════════════════════════
#  IMAGE VERSION — optional, for docker-compose.yml
# ════════════════════════════════════════════════════════════

# Pin a specific release instead of tracking :latest.
# VERSION=1.6.0


# ════════════════════════════════════════════════════════════
#  ADVANCED (optional) — boot-time only, no panel equivalent
#  Only needed for specific edge cases (see docs/deploy-docker.md).
#  Unlike firewall backend, log level, TLS, etc., these five have
#  NO setting in the web panel — .env is the only way to change
#  them, ever. Require a container restart to apply.
# ════════════════════════════════════════════════════════════

# WireGuard UDP port. Change only if 51820 is already used by
# something else on this host.
# WIREGO_WG_PORT=51820

# VPN subnet. Change only if 10.8.0.0/24 collides with a network you
# already route to. The server takes .1, peers get .2 onward.
# WIREGO_WG_SUBNET=10.8.0.0/24

# WireGuard kernel interface name. Change only if "wg0" collides with
# an interface already used on the host.
# WIREGO_WG_INTERFACE=wg0

# Web panel listen address. Change only if you need to bind to a
# specific interface (e.g. a LAN-only IP) instead of all interfaces.
# WIREGO_API_LISTEN_ADDR=0.0.0.0:51821

# SQLite database path inside the container. Change only alongside a
# matching change to the volume mount in docker-compose.yml.
# WIREGO_DB_PATH=/data/wirego.db
